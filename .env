# ── API base URL (REST + Socket.IO both use this) ─────────────────────
# development — API gateway, single port in front of backend (8081) + grn-service (8084):
# VITE_API_URL=http://localhost:8000
# production:
# VITE_API_URL=https://uatback.spacetextiles.net

# Direct to backend (no gateway — grn-service screens won't get the auth bridge):
VITE_API_URL=http://localhost:7000
# VITE_API_URL=http://10.0.20.4:8081
# VITE_API_URL=http://14.96.15.50:8082
# Left blank on purpose — every API/Socket.IO call becomes a relative path
# (e.g. /api/secure/log_user) so the browser's Network tab only ever shows
# this frontend's own origin. vite.config.ts proxies /api and /socket.io
# server-side to the real backend above.
# VITE_API_URL=
VITE_API_KEY=your-api-key-here
VITE_APP_NAME=Non-Trade
VITE_USER_NAME=STPL
VITE_USER_PASSWORD=stpl@123
